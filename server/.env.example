# ============ 对话 API（驱动 Pi Agent 的 function calling）============
# 对话 Key（无 Key 服务也能启动，到控制台「设置」页填即可）
CHAT_API_KEY=sk-...
# 对话兼容端点，默认 https://api.openai.com/v1
CHAT_BASE_URL=https://api.openai.com/v1
# 对话模型（可自由填写；会在运行时注入 Pi 的 models.json）
CHAT_MODEL=gpt-4o
# 对话模型是否支持图片识别（vision）；开启后上传图片会作为视觉内容发给模型
# CHAT_VISION=true
# 自定义 System Prompt（也可在控制台「设置」页修改并保存）
# SYSTEM_PROMPT=你是一个图片生成助手...

# ============ 图像 API（gpt-image-1 文生图 / 编辑）====================
# 图像 Key（与对话 Key 相互独立，可填不同服务）
IMAGE_API_KEY=sk-...
# 图像兼容端点，默认 https://api.openai.com/v1
IMAGE_BASE_URL=https://api.openai.com/v1
# 图像生成模型
IMAGE_MODEL=gpt-image-1

# ============ 兼容旧配置（上面两组留空时，会回退到这两个值）==========
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 服务 ====================================================
PORT=3001
CORS_ORIGIN=*
# 启动后自动打开浏览器；设为 none 可关闭
BROWSER=auto
# 可选：对外访问地址（影响自动打开与日志显示，如 http://your-domain.com）
# PUBLIC_BASE_URL=

# 生成图片输出目录（相对 server/）
OUTPUT_DIR=./outputs
# Skill 目录（相对 server/，默认 ./skills，即 server/skills）
# 每个 skill 是目录下含 SKILL.md 的子目录；这里只认这一层，不再回退用户目录或示例目录
SKILLS_DIR=./skills
